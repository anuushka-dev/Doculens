
# Application
DOCULENS_ENVIRONMENT=development
DOCULENS_LOG_LEVEL=INFO

# PDF ingestion
DOCULENS_MAX_UPLOAD_BYTES=20971520
DOCULENS_MAX_PDF_PAGES=250

# Local Ollama
DOCULENS_OLLAMA_BASE_URL=http://localhost:11434
DOCULENS_OLLAMA_MODEL=qwen3.5:2b
DOCULENS_OLLAMA_TIMEOUT_SECONDS=120
DOCULENS_OLLAMA_NUM_CTX=8192
DOCULENS_OLLAMA_NUM_PREDICT=1024
DOCULENS_OLLAMA_TEMPERATURE=0.0
DOCULENS_OLLAMA_SEED=42

# Retrieval
DOCULENS_RETRIEVAL_TOP_K=5
DOCULENS_EVIDENCE_THRESHOLD=0.25
DOCULENS_MAX_CONTEXT_CHARS=12000

# Structured extraction
DOCULENS_EXTRACTION_MAX_REPAIR_ATTEMPTS=1
